// Resources for FileLocker.exe. IDs are referenced from src/shell.rs.

1 ICON "assets/app.ico"
101 ICON "assets/tray-locked.ico"
102 ICON "assets/tray-unlocked.ico"

// RT_MANIFEST
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3f
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "File Locker"
            VALUE "FileDescription", "File Locker"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "FileLocker"
            VALUE "OriginalFilename", "FileLocker.exe"
            VALUE "ProductName", "File Locker"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
