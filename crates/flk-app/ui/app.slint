// File Locker windows. Rust drives them from src/ui.rs; every window hides
// (rather than quits) when closed, because the app keeps running in the tray.

import {
    Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, SpinBox, Spinner,
    Switch, AboutSlint,
} from "std-widgets.slint";

export struct VaultRow {
    name: string,
    path: string,
    unlocked: bool,
    drive: string,
    busy: bool,
}

global Theme {
    out property <color> error: Palette.color-scheme == ColorScheme.dark ? #ff99a4 : #c42b1c;
    out property <color> success: Palette.color-scheme == ColorScheme.dark ? #6ccb5f : #0f7b0f;
    out property <color> card: Palette.color-scheme == ColorScheme.dark ? #2b2b2b : #f3f3f3;
    out property <color> card-border: Palette.color-scheme == ColorScheme.dark ? #3a3a3a : #e1e1e1;
}

component Title inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    // A path or similar: one line, shortened with "…" if too long.
    in property <bool> subtitle-one-line;
    in property <image> icon: @image-url("../assets/app.png");
    spacing: 10px;
    HorizontalLayout {
        spacing: 14px;
        Image {
            source: root.icon;
            width: 40px;
            height: 40px;
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                font-size: 18px;
                font-weight: 600;
                overflow: elide;
            }
        }
    }

    if root.subtitle != "" && !root.subtitle-one-line: Text {
        text: root.subtitle;
        font-size: 12px;
        opacity: 0.75;
        wrap: word-wrap;
    }
    if root.subtitle != "" && root.subtitle-one-line: Text {
        text: root.subtitle;
        font-size: 12px;
        opacity: 0.6;
        overflow: elide;
    }
}

// The main window's header: icon, name and tagline side by side.
component Header inherits HorizontalLayout {
    spacing: 14px;
    Image {
        source: @image-url("../assets/app.png");
        width: 44px;
        height: 44px;
    }

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: "File Locker";
            font-size: 20px;
            font-weight: 600;
        }

        Text {
            text: "Encrypted vaults that open as a drive";
            font-size: 12px;
            opacity: 0.7;
        }
    }
}

component ErrorText inherits Text {
    color: Theme.error;
    wrap: word-wrap;
}

component Label inherits Text {
    font-size: 12px;
    opacity: 0.85;
}

component Note inherits Text {
    font-size: 12px;
    opacity: 0.7;
    wrap: word-wrap;
}

// A text link that works with the mouse, the keyboard (Tab, then Enter or
// Space) and screen readers.
component Link inherits Rectangle {
    in property <string> text;
    callback clicked;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    preferred-width: label.preferred-width;
    preferred-height: label.preferred-height + 2px;
    min-width: label.min-width;
    label := Text {
        text: root.text;
        color: Palette.accent-background;
        font-size: 12px;
        vertical-alignment: center;
    }

    if focus.has-focus: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.accent-background;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

// A button centred vertically inside a horizontal row.
component RowButton inherits VerticalLayout {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    alignment: center;
    Button {
        text: root.text;
        primary: root.primary;
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component VaultCard inherits Rectangle {
    in property <VaultRow> vault;
    callback unlock;
    callback open;
    callback lock;
    callback change-password;
    callback remove;
    border-radius: 8px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-border;
    height: 78px;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.vault.unlocked ? @image-url("../assets/unlocked.png") : @image-url("../assets/app.png");
                width: 36px;
                height: 36px;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.vault.name;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.vault.busy ? "Working…" : root.vault.unlocked ? "Unlocked as drive " + root.vault.drive : "Locked";
                font-size: 12px;
                color: root.vault.unlocked ? Theme.success : Palette.foreground;
                opacity: root.vault.unlocked ? 1 : 0.75;
            }

            Text {
                text: root.vault.path;
                font-size: 11px;
                opacity: 0.55;
                overflow: elide;
            }
        }

        if !root.vault.unlocked: RowButton {
            text: "Unlock";
            primary: true;
            enabled: !root.vault.busy;
            clicked => {
                root.unlock();
            }
        }
        if root.vault.unlocked: RowButton {
            text: "Open";
            clicked => {
                root.open();
            }
        }
        if root.vault.unlocked: RowButton {
            text: "Lock";
            primary: true;
            enabled: !root.vault.busy;
            clicked => {
                root.lock();
            }
        }
        RowButton {
            text: "•••";
            enabled: !root.vault.busy;
            clicked => {
                menu.show();
            }
        }
    }

    menu := PopupWindow {
        x: root.width - 200px;
        y: root.height - 8px;
        width: 190px;
        Rectangle {
            background: Palette.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.card-border;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                Button {
                    text: "Change password…";
                    clicked => {
                        root.change-password();
                    }
                }

                Button {
                    text: "Remove from list";
                    clicked => {
                        root.remove();
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "File Locker";
    icon: @image-url("../assets/app.png");
    preferred-width: 640px;
    preferred-height: 480px;
    min-width: 500px;
    min-height: 380px;
    in property <[VaultRow]> vaults;
    in property <bool> any-unlocked;
    in property <string> status;
    in property <bool> status-is-error;
    callback unlock(int);
    callback open(int);
    callback lock(int);
    callback change-password(int);
    callback remove(int);
    callback create;
    callback add-existing;
    callback settings;
    callback lock-all;
    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            Header {
                horizontal-stretch: 1;
            }

            RowButton {
                text: "Lock all";
                enabled: root.any-unlocked;
                clicked => {
                    root.lock-all();
                }
            }
        }

        if root.vaults.length == 0: Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: Theme.card;
            VerticalLayout {
                alignment: center;
                padding: 24px;
                spacing: 10px;
                Text {
                    text: "No vaults yet";
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Note {
                    text: "A vault is a folder whose files are always encrypted on disk. Unlock it with your password and it opens as a drive in Explorer.";
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Button {
                        text: "Create a vault";
                        primary: true;
                        clicked => {
                            root.create();
                        }
                    }

                    Button {
                        text: "Add an existing vault";
                        clicked => {
                            root.add-existing();
                        }
                    }
                }
            }
        }
        if root.vaults.length > 0: ListView {
            vertical-stretch: 1;
            for row[index] in root.vaults: VerticalLayout {
                padding-bottom: 8px;
                VaultCard {
                    vault: row;
                    unlock => {
                        root.unlock(index);
                    }
                    open => {
                        root.open(index);
                    }
                    lock => {
                        root.lock(index);
                    }
                    change-password => {
                        root.change-password(index);
                    }
                    remove => {
                        root.remove(index);
                    }
                }
            }
        }
        if root.status != "": Text {
            text: root.status;
            wrap: word-wrap;
            font-size: 12px;
            color: root.status-is-error ? Theme.error : Palette.foreground;
        }
        HorizontalLayout {
            spacing: 8px;
            if root.vaults.length > 0: Button {
                text: "Create vault…";
                clicked => {
                    root.create();
                }
            }
            if root.vaults.length > 0: Button {
                text: "Add existing…";
                clicked => {
                    root.add-existing();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Settings";
                clicked => {
                    root.settings();
                }
            }
        }
    }
}

export component UnlockDialog inherits Window {
    title: "Unlock vault";
    icon: @image-url("../assets/app.png");
    width: 440px;
    in property <string> vault-name;
    in property <string> vault-path;
    in property <string> error;
    in property <bool> busy;
    in-out property <string> password;
    callback unlock(string);
    callback cancel;
    callback forgot;
    public function focus-password() {
        pw.focus();
    }
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        Title {
            title: "Unlock “" + root.vault-name + "”";
            subtitle: root.vault-path;
            subtitle-one-line: true;
        }

        pw := LineEdit {
            input-type: InputType.password;
            placeholder-text: "Password";
            text <=> root.password;
            enabled: !root.busy;
            accepted(text) => {
                if !root.busy && text != "" {
                    root.unlock(text);
                }
            }
        }

        if root.error != "": ErrorText {
            text: root.error;
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Link {
                    text: "Forgot password?";
                    clicked => {
                        root.forgot();
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.busy: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }

            Button {
                text: "Unlock";
                primary: true;
                enabled: !root.busy && pw.text != "";
                clicked => {
                    root.unlock(pw.text);
                }
            }
        }
    }
}

export component CreateDialog inherits Window {
    title: "Create a vault";
    icon: @image-url("../assets/app.png");
    width: 500px;
    // 0: details, 1: recovery key
    in property <int> page;
    in-out property <string> name: "My Vault";
    in-out property <string> location;
    in-out property <string> password;
    in-out property <string> confirm;
    in property <string> strength;
    in property <int> strength-level;
    in property <string> error;
    in property <bool> busy;
    in property <string> key-line-1;
    in property <string> key-line-2;
    in property <string> key-note;
    in-out property <bool> saved;
    in-out property <bool> unlock-now: true;
    callback browse;
    callback password-edited(string);
    callback create(string, string, string, string);
    callback copy-key;
    callback save-key;
    callback finish(bool);
    callback cancel;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        if root.page == 0: VerticalLayout {
            spacing: 10px;
            Title {
                title: "Create a vault";
                subtitle: "Files you put in the vault are encrypted on disk. It opens as a drive when unlocked.";
            }

            Label {
                text: "Vault name";
            }

            LineEdit {
                text <=> root.name;
                enabled: !root.busy;
            }

            Label {
                text: "Location";
            }

            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.location;
                    enabled: !root.busy;
                }

                Button {
                    text: "Browse…";
                    enabled: !root.busy;
                    clicked => {
                        root.browse();
                    }
                }
            }

            Note {
                text: "The vault is created as a new folder named after the vault inside this location. It can live anywhere: another drive, a USB stick, or a synced folder.";
            }

            Label {
                text: "Password";
            }

            LineEdit {
                input-type: InputType.password;
                text <=> root.password;
                enabled: !root.busy;
                edited(text) => {
                    root.password-edited(text);
                }
            }

            if root.strength != "": HorizontalLayout {
                spacing: 8px;
                for i in 4: Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: i < root.strength-level ? (root.strength-level <= 1 ? Theme.error : root.strength-level == 2 ? #c19c00 : Theme.success) : Theme.card-border;
                }
                Text {
                    text: root.strength;
                    font-size: 11px;
                    opacity: 0.8;
                }
            }
            Label {
                text: "Confirm password";
            }

            LineEdit {
                input-type: InputType.password;
                text <=> root.confirm;
                enabled: !root.busy;
            }

            if root.error != "": ErrorText {
                text: root.error;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if root.busy: VerticalLayout {
                    alignment: center;
                    Spinner {
                        width: 22px;
                        height: 22px;
                        indeterminate: true;
                    }
                }
                Button {
                    text: "Cancel";
                    enabled: !root.busy;
                    clicked => {
                        root.cancel();
                    }
                }

                Button {
                    text: "Create";
                    primary: true;
                    enabled: !root.busy;
                    clicked => {
                        root.create(root.name, root.location, root.password, root.confirm);
                    }
                }
            }
        }
        if root.page == 1: VerticalLayout {
            spacing: 12px;
            Title {
                title: "Save your recovery key";
                subtitle: "If you forget your password, this key is the only way back into your vault. Nobody, including us, can recover it for you.";
            }

            Rectangle {
                border-radius: 6px;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.card-border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    Text {
                        text: root.key-line-1;
                        font-family: "Consolas";
                        font-size: 15px;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.key-line-2;
                        font-family: "Consolas";
                        font-size: 15px;
                        horizontal-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                RowButton {
                    text: "Copy";
                    clicked => {
                        root.copy-key();
                    }
                }

                RowButton {
                    text: "Save to a file…";
                    clicked => {
                        root.save-key();
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.key-note;
                        font-size: 12px;
                        color: Theme.success;
                    }
                }
            }

            Note {
                text: "Keep it away from this computer: print it, or save it to a USB stick or a password manager.";
            }

            CheckBox {
                text: "I saved my recovery key somewhere safe";
                checked <=> root.saved;
            }

            CheckBox {
                text: "Unlock the vault now";
                checked <=> root.unlock-now;
            }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: "Finish";
                    primary: true;
                    enabled: root.saved;
                    clicked => {
                        root.finish(root.unlock-now);
                    }
                }
            }
        }
    }
}

export component RecoverDialog inherits Window {
    title: "Reset password";
    icon: @image-url("../assets/app.png");
    width: 480px;
    in property <string> vault-name;
    in-out property <string> key;
    in-out property <string> password;
    in-out property <string> confirm;
    in property <string> error;
    in property <bool> busy;
    callback reset(string, string, string);
    callback cancel;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        Title {
            title: "Reset the password of “" + root.vault-name + "”";
            subtitle: "Enter the recovery key you saved when you created the vault, then choose a new password.";
        }

        Label {
            text: "Recovery key";
        }

        LineEdit {
            text <=> root.key;
            placeholder-text: "XXXX-XXXX-XXXX-…";
            font-family: "Consolas";
            enabled: !root.busy;
        }

        Label {
            text: "New password";
        }

        LineEdit {
            input-type: InputType.password;
            text <=> root.password;
            enabled: !root.busy;
        }

        Label {
            text: "Confirm new password";
        }

        LineEdit {
            input-type: InputType.password;
            text <=> root.confirm;
            enabled: !root.busy;
        }

        if root.error != "": ErrorText {
            text: root.error;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if root.busy: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            Button {
                text: "Cancel";
                enabled: !root.busy;
                clicked => {
                    root.cancel();
                }
            }

            Button {
                text: "Reset password";
                primary: true;
                enabled: !root.busy;
                clicked => {
                    root.reset(root.key, root.password, root.confirm);
                }
            }
        }
    }
}

export component PasswordDialog inherits Window {
    title: "Change password";
    icon: @image-url("../assets/app.png");
    width: 440px;
    in property <string> vault-name;
    in-out property <string> current;
    in-out property <string> password;
    in-out property <string> confirm;
    in property <string> error;
    in property <bool> busy;
    callback change(string, string, string);
    callback cancel;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        Title {
            title: "Change the password of “" + root.vault-name + "”";
            subtitle: "Your files are not re-encrypted, and your recovery key stays the same.";
        }

        Label {
            text: "Current password";
        }

        LineEdit {
            input-type: InputType.password;
            text <=> root.current;
            enabled: !root.busy;
        }

        Label {
            text: "New password";
        }

        LineEdit {
            input-type: InputType.password;
            text <=> root.password;
            enabled: !root.busy;
        }

        Label {
            text: "Confirm new password";
        }

        LineEdit {
            input-type: InputType.password;
            text <=> root.confirm;
            enabled: !root.busy;
        }

        if root.error != "": ErrorText {
            text: root.error;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if root.busy: VerticalLayout {
                alignment: center;
                Spinner {
                    width: 22px;
                    height: 22px;
                    indeterminate: true;
                }
            }
            Button {
                text: "Cancel";
                enabled: !root.busy;
                clicked => {
                    root.cancel();
                }
            }

            Button {
                text: "Change password";
                primary: true;
                enabled: !root.busy;
                clicked => {
                    root.change(root.current, root.password, root.confirm);
                }
            }
        }
    }
}

export component SettingsDialog inherits Window {
    title: "File Locker settings";
    icon: @image-url("../assets/app.png");
    width: 480px;
    in-out property <bool> lock-on-sleep;
    in-out property <bool> lock-on-windows-lock;
    in-out property <bool> idle-enabled;
    in-out property <int> idle-minutes: 15;
    in-out property <bool> open-explorer;
    in-out property <bool> hotkey;
    in-out property <bool> start-with-windows;
    in property <string> version;
    in property <string> winfsp;
    callback save;
    callback cancel;
    callback about;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        Title {
            title: "Settings";
        }

        Text {
            text: "Lock all vaults automatically";
            font-weight: 600;
        }

        Switch {
            text: "When the PC goes to sleep or hibernates";
            checked <=> root.lock-on-sleep;
        }

        Switch {
            text: "When Windows is locked (Win+L, or the lock screen)";
            checked <=> root.lock-on-windows-lock;
        }

        HorizontalLayout {
            spacing: 10px;
            Switch {
                text: "After the PC is idle for";
                checked <=> root.idle-enabled;
            }

            SpinBox {
                width: 110px;
                minimum: 1;
                maximum: 240;
                value <=> root.idle-minutes;
                enabled: root.idle-enabled;
            }

            VerticalLayout {
                alignment: center;
                Text {
                    text: "minutes";
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        Switch {
            text: "With the shortcut Ctrl+Alt+L";
            checked <=> root.hotkey;
        }

        Rectangle {
            height: 6px;
        }

        Text {
            text: "General";
            font-weight: 600;
        }

        Switch {
            text: "Open the drive in Explorer after unlocking";
            checked <=> root.open-explorer;
        }

        Switch {
            text: "Start File Locker when I sign in to Windows";
            checked <=> root.start-with-windows;
        }

        Rectangle {
            height: 6px;
        }

        HorizontalLayout {
            spacing: 12px;
            Note {
                text: "File Locker " + root.version + " · " + root.winfsp;
            }

            Link {
                text: "About File Locker";
                clicked => {
                    root.about();
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: "Cancel";
                clicked => {
                    root.cancel();
                }
            }

            Button {
                text: "Save";
                primary: true;
                clicked => {
                    root.save();
                }
            }
        }

    }
}

export component MoveDialog inherits Window {
    title: "Move into vault";
    icon: @image-url("../assets/app.png");
    width: 500px;
    // One item name per line, and the folder they come from.
    in property <string> sources;
    in property <string> from;
    in property <int> source-count;
    in property <[string]> vault-names;
    in-out property <int> vault-index;
    // 0: ready, 1: moving, 2: finished
    in property <int> state;
    in property <float> progress;
    in property <string> status;
    in property <bool> status-is-error;
    callback move(int);
    callback cancel;
    callback dismiss;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        Title {
            title: root.source-count == 1 ? "Move 1 item into a vault" : "Move " + root.source-count + " items into a vault";
            subtitle: "Items are copied into the vault, checked, and then deleted from where they are now.";
        }

        Rectangle {
            border-radius: 6px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-border;
            height: 104px;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: root.sources;
                    font-size: 13px;
                    overflow: elide;
                    vertical-stretch: 1;
                }

                Text {
                    text: root.from;
                    font-size: 11px;
                    opacity: 0.6;
                    overflow: elide;
                }
            }
        }

        Label {
            text: "Vault";
        }

        ComboBox {
            model: root.vault-names;
            current-index <=> root.vault-index;
            enabled: root.state == 0;
        }

        Note {
            height: 36px;
            text: "Deleted originals can sometimes be recovered with special tools, especially on SSDs. Create sensitive files inside the vault when you can.";
        }

        ProgressIndicator {
            progress: root.progress;
            opacity: root.state == 0 ? 0 : 1;
        }

        Rectangle {
            height: 52px;
            Text {
                width: 100%;
                height: 100%;
                text: root.status;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
                font-size: 12px;
                color: root.status-is-error ? Theme.error : Palette.foreground;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if root.state == 0: Button {
                text: "Cancel";
                clicked => {
                    root.dismiss();
                }
            }
            if root.state == 0: Button {
                text: "Move";
                primary: true;
                enabled: root.vault-names.length > 0 && root.source-count > 0;
                clicked => {
                    root.move(root.vault-index);
                }
            }
            if root.state == 1: Button {
                text: "Stop";
                clicked => {
                    root.cancel();
                }
            }
            if root.state == 2: Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}

export component AboutDialog inherits Window {
    title: "About File Locker";
    icon: @image-url("../assets/app.png");
    width: 460px;
    in property <string> version;
    callback dismiss;
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        Title {
            title: "File Locker " + root.version;
            subtitle: "Encrypted folder vaults for Windows. Files are encrypted on disk with AES-256 and open as a drive only while unlocked.";
        }

        Note {
            text: "Uses WinFsp, the Windows File System Proxy (winfsp.dev), © Bill Zissimopoulos, licensed under GPLv3 with the FLOSS exception.";
        }

        HorizontalLayout {
            alignment: center;
            AboutSlint {
                width: 220px;
                height: 120px;
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                primary: true;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
